# Root example env. Copy relevant values into app/.env and contracts/.env.
# NEVER commit real .env files — only this example belongs in git.

# --- Shared (public) ---
NEXT_PUBLIC_CONTRACT_ADDRESS=      # set after BC deploys to Sepolia
NEXT_PUBLIC_CHAIN_ID=11155111      # Sepolia

# --- Backend (app/.env) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crowdfunding?schema=public
SEPOLIA_RPC_URL=                   # e.g. an Alchemy/Infura Sepolia endpoint

# --- Contracts (contracts/.env) ---
# Deployment key stays on the deployer's machine only — never in the browser, never committed.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
