# Copy to app/.env (git-ignored). Only NEXT_PUBLIC_* values reach the browser.
# See docs/04-deployment.md for the full production setup (Neon + Vercel + GitHub Actions).

# Pooled connection used by the app at runtime.
# Local: a plain local Postgres URL. Production (Neon): the POOLED url (append ?pgbouncer=true&connection_limit=1).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crowdfunding?schema=public
# Direct (unpooled) connection used only by `prisma migrate`.
# Local: set equal to DATABASE_URL. Production (Neon): the DIRECT (unpooled) url.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/crowdfunding?schema=public

# Sepolia JSON-RPC endpoint (e.g. an Alchemy/Infura https URL). Server-side only.
SEPOLIA_RPC_URL=
# Deployed CrowdfundingEscrow address. NEXT_PUBLIC_* bakes in at BUILD time — changing it needs a redeploy.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111

# Shared secret that gates the /api/cron/index indexer route (set the same value as a
# GitHub Actions / Vercel cron secret). Generate a random string; leave blank locally if unused.
CRON_SECRET=
# Optional indexer tuning. Defaults: LOG_RANGE=10 (free-tier getLogs cap), CRON_LOOKBACK=300 blocks.
# INDEXER_LOG_RANGE=10
# CRON_LOOKBACK=300
